# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_actual_api_key_here

# Email address where you want to receive application notifications
NOTIFICATION_EMAIL=your-email@example.com

# Sanity Configuration
# Get your credentials from https://www.sanity.io/manage
# Project ID: Found in your Sanity project settings
SANITY_PROJECT_ID=your_sanity_project_id
# Dataset name: Usually "production"
SANITY_DATASET=production
# API Token: Create one with Editor permissions in your Sanity project settings > API > Tokens
SANITY_API_TOKEN=your_sanity_api_token
# Public credentials for client-side file uploads
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
